{
  "name": "movies-api",
  "version": "1.0.0",
  "description": "API REST Node.js + TypeScript + TypeORM para gestionar usuarios, películas y categorías (PostgreSQL local, sin Docker).",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node -r dotenv/config dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/server.ts",
    "heroku-postbuild": "npm run build",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/shared/data-source.js"
  },

  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
